{
  "name": "cantika-pos-desktop",
  "version": "1.0.0",
  "description": "Cantika Beauty Store Enterprise Native Desktop Application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis",
    "pack": "electron-builder --dir"
  },
  "keywords": [
    "pos",
    "desktop",
    "electron",
    "cantika-beauty-store"
  ],
  "author": "Cantika Beauty Store",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.cantikabeautystore.pos",
    "productName": "Cantika Beauty Store POS",
    "copyright": "Copyright © 2026 Cantika Beauty Store",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "main.js",
      "preload.js",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cantika POS Enterprise"
    }
  }
}
